      "configuration" : {
        "scriptLang" : "TBEL",
        "jsScript" : "return {msg: msg, metadata: metadata, msgType: msgType};",
        "tbelScript" : "var response = {};\n\n// Inspect the incoming device's request method\nif (msg.method === 'getCurrentTime') {\n    response = {\n        \"method\" : msg.method,\n        \"params\" : {\"epoch_ms\": new Date().getTime() }\n    };\n} else if (msg.method === 'setStatus') {\n    // Acknowledge the status change\n    response = {\n        \"method\" : msg.method,\n        \"params\" : {\n        \"success\": true,\n        \"currentStatus\": msg.params.status\n        }\n    };\n} else {\n    response = {\n        \"error\": \"Method '\" + msg.method + \"' is not supported.\"\n    };\n}\n\n// Return the reply payload back to the RPC Call Reply node\nreturn { msg: response, metadata: metadata, msgType: msgType };"
