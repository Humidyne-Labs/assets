        "bodyTemplate" : "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>HUMID1 Alarm Notification</title>\n</head>\n<body style=\"font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; background-color: #080808; color: #ffffff; margin: 0; padding: 30px 10px; -webkit-font-smoothing: antialiased;\">\n    <table role=\"presentation\" width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n        <tr>\n            <td align=\"center\">\n                <table role=\"presentation\" width=\"100%\" style=\"max-width: 580px; background-color: #111111; border: 2px solid #333333; box-shadow: 6px 6px 0px #222222; padding: 24px; text-align: left;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                    <!-- HEADER -->\n                    <tr>\n                        <td style=\"border-bottom: 2px solid #333333; padding-bottom: 14px; margin-bottom: 20px;\">\n                            <h1 style=\"margin: 0; font-size: 16px; font-weight: 800; letter-spacing: 0.05em; color: #ffffff; text-transform: uppercase;\">\n                                HUMID1 :: TELEMETRY_ALARM\n                            </h1>\n                        </td>\n                    </tr>\n                    <!-- CONTENT -->\n                    <tr>\n                        <td style=\"font-size: 13px; line-height: 1.6; color: #dddddd; padding-top: 20px;\">\n                            <p style=\"color: #ff3b30; font-weight: bold; margin-top: 0;\">[SYSTEM_DISPATCH :: ALARM_ALERT]</p>\n                            <p>An active system anomaly has been detected for node <code style=\"background-color: #1a1a1a; padding: 2px 6px; border: 1px solid #333333; color: #ffffff;\">${alarmOriginatorName}</code>.</p>\n                            \n                            <!-- ALARM METADATA -->\n                            <table role=\"presentation\" width=\"100%\" style=\"margin: 20px 0 10px 0; border-collapse: collapse; border: 1px solid #333333; font-size: 12px; background-color: #161616;\">\n                                <tr style=\"border-bottom: 1px solid #262626;\">\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold; width: 40%;\">ORIGINATOR:</td>\n                                    <td style=\"padding: 10px; color: #ffffff;\">${alarmOriginatorName}</td>\n                                </tr>\n                                <tr style=\"border-bottom: 1px solid #262626;\">\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold;\">ALARM TYPE:</td>\n                                    <td style=\"padding: 10px; color: #ffffff;\">${alarmTypeUpper}</td>\n                                </tr>\n                                <tr style=\"border-bottom: 1px solid #262626;\">\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold;\">SEVERITY:</td>\n                                    <td style=\"padding: 10px; color: #ff3b30; font-weight: bold;\">${alarmSeverityUpper}</td>\n                                </tr>\n                                <tr>\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold;\">STATUS:</td>\n                                    <td style=\"padding: 10px; color: #ffffff;\">${alarmStatus}</td>\n                                </tr>\n                            </table>\n\n                            <!-- TELEMETRY SNAPSHOT -->\n                            <table role=\"presentation\" width=\"100%\" style=\"margin: 0 0 20px 0; border-collapse: collapse; border: 1px solid #333333; font-size: 12px; background-color: #161616;\">\n                                <tr style=\"border-bottom: 1px solid #262626;\">\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold; width: 40%;\">TEMPERATURE:</td>\n                                    <td style=\"padding: 10px; color: #34c759; font-weight: bold;\">${scaled_temp}</td>\n                                </tr>\n                                <tr style=\"border-bottom: 1px solid #262626;\">\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold;\">RELATIVE HUMIDITY:</td>\n                                    <td style=\"padding: 10px; color: #007aff; font-weight: bold;\">${rh}%</td>\n                                </tr>\n                                <tr>\n                                    <td style=\"padding: 10px; color: #888888; font-weight: bold;\">BATTERY LEVEL:</td>\n                                    <td style=\"padding: 10px; color: #ffffff;\">${battery}%</td>\n                                </tr>\n                            </table>\n\n                            <p style=\"text-align: center; margin: 30px 0;\">\n                                <a href=\"https://dash.humid1.com\" style=\"display: inline-block; background-color: #ff3b30; color: #ffffff !important; text-decoration: none; padding: 12px 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; font-size: 12px; border: 1px solid #ff3b30;\">\n                                    VIEW_DASHBOARD\n                                </a>\n                            </p>\n                            <p style=\"font-size: 11px; color: #777777; margin-bottom: 0;\">Automated alert generated by HUMID1 telemetry engine. Do not reply to this transmission.</p>\n                        </td>\n                    </tr>\n                    <!-- FOOTER -->\n                    <tr>\n                        <td style=\"border-top: 1px solid #262626; margin-top: 30px; padding-top: 16px; font-size: 10px; color: #666666; text-transform: uppercase; letter-spacing: 0.05em;\">\n                            <p style=\"margin: 2px 0;\">© 2026 HUMIDYNE LABS. ALL_RIGHTS_RESERVED.</p>\n         