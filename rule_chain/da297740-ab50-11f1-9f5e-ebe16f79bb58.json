      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "// Helper to validate email syntax\nfunction isValidEmail(val) {\n    if (!val || typeof val !== 'string') return false;\n    var emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    return emailPattern.test(val.trim());\n}\n\n// Validate customer_title and assign userEmail with fallback\nif (isValidEmail(metadata.customer_title)) {\n    metadata.userEmail = metadata.customer_title.trim().toLowerCase();\n} else {\n    metadata.userEmail = \"support@humid1.com\";\n}\n\n// Delete the unneeded raw string key\ndelete metadata.customer_title;\n\n// Map missing keys and format strings for HTML rendering\nmetadata.alarmOriginatorName = metadata.deviceName || \"Unknown Node\";\nmetadata.alarmTypeUpper = metadata.alarmType ? metadata.alarmType.toUpperCase() : \"ALARM\";\nmetadata.alarmSeverityUpper = metadata.alarmSeverity ? metadata.alarmSeverity.toUpperCase() : \"WARNING\";\nmetadata.alarmStatus = metadata.isExistingAlarm === \"true\" ? \"ACTIVE (UPDATED)\" : \"ACTIVE (NEW)\";\n\n// --- Kelvin Temperature Conversion ---\nvar rawTemp = parseFloat(msg.temp !== undefined ? msg.temp : metadata.temp);\n\nif (!isNaN(rawTemp)) {\n    // Check shared attribute (handles both raw key and ThingsBoard 'ss_' prefix)\n    var unitAttr = metadata.shared_temp_unit || metadata.ss_shared_temp_unit || \"F\";\n    var isCelsius = unitAttr.toString().toUpperCase().trim().indexOf(\"C\") === 0;\n\n    // Convert Kelvin to Celsius or Fahrenheit\n    var convertedTemp = isCelsius \n        ? rawTemp - 273.15 \n        : (rawTemp - 273.15) * 1.8 + 32;\n\n    var unitSymbol = isCelsius ? \"°C\" : \"°F\";\n\n    // Formatted string for HTML email templates (e.g., \"70.2 °F\")\n    metadata.scaled_temp = convertedTemp.toFixed(1) + \" \" + unitSymbol;\n    \n    // Numeric value added to payload\n    msg.scaled_temp = parseFloat(convertedTemp.toFixed(2));\n} else {\n    metadata.scaled_temp = \"N/A\";\n}\n\nreturn {msg: msg, metadata: metadata, msgType: msgType};",
        "tbelScript" : "return {msg: msg, metadata: metadata, msgType: msgType};"
