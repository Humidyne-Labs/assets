{
  "mcpServers": {
    "esp-component-registry": {
      "serverUrl": "https://components.espressif.com/mcp"
    },
    "espressif-documentation": {
      "serverUrl": "https://mcp.espressif.com/docs"
    },
    "firmware-analyzer": {
      "command": "python",
      "args": [
        "c:/Users/Matt/Documents/GitHub/assets/tool_harness/mcp_servers/firmware_analyzer_mcp.py"
      ],
      "env": {
        "BSP_BUILD_ROOT": "C:\\Users\\Matt\\Documents\\GitHub\\H1OS\\examples\\H1OS"
      }
    },
    "idf-build": {
      "command": "python",
      "args": [
        "c:/Users/Matt/Documents/GitHub/assets/tool_harness/mcp_servers/idf_build_mcp_server.py"
      ],
      "env": {
        "BSP_BUILD_ROOT": "C:\\Users\\Matt\\Documents\\GitHub\\H1OS\\examples\\H1OS"
      }
    },
    "clangd": {
      "command": "python",
      "args": [
        "c:/Users/Matt/Documents/GitHub/assets/tool_harness/mcp_servers/clangd_mcp_server.py"
      ],
      "env": {
        "CLANGD_PATH": "C:\\clang+llvm-18.1.8\\bin\\clangd.exe",
        "WORKSPACE_ROOT": "C:\\Users\\Matt\\Documents\\GitHub\\H1OS"
      }
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "graphifyy",
        "--with",
        "mcp",
        "-m",
        "graphify.serve",
        "${workspace.path}/graphify-out/graph.json"
      ]
    }
  }
}
