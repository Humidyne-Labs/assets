{
  "mcpServers": {
    "clangd": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/schuay/clangd-mcp.git",
        "--with",
        "mcp<2",
        "clangd-mcp",
        "--clangd",
        "C:/clang+llvm-18.1.8/bin/clangd_esp32.cmd",
        "--compile-commands-dir",
        "C:/Users/Matt/Documents/GitHub/H1OS/examples/H1OS/build_dev",
        "--workspace-dir",
        "C:/Users/Matt/Documents/GitHub/H1OS"
      ]
    },
    "esp-idf": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "C:\\esp\\v6.1\\esp-idf\\export.bat > nul && idf.py -C C:/Users/Matt/Documents/GitHub/H1OS/examples/H1OS mcp-server"
      ]
    },
    "local-index": {
      "command": "uvx",
      "args": [
        "code-index-mcp",
        "--project-path",
        "C:/Users/Matt/Documents/GitHub/H1OS/docs"
      ]
    },
    "duckdb": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-duckdb",
        "--db-path",
        ":memory:"
      ]
    },
    "science": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp<2",
        "--with",
        "sympy",
        "--with",
        "z3-solver",
        "--with",
        "scipy",
        "--with",
        "numpy",
        "c:/Users/Matt/Documents/GitHub/assets/tool_harness/tools/science_mcp.py"
      ]
    },
    "espressif-documentation": {
      "serverUrl": "https://mcp.espressif.com/docs"
    },
    "esp-component-registry": {
      "serverUrl": "https://components.espressif.com/mcp"
    }
  }
}
